{
  "name": "nebulax-desktop",
  "productName": "NebulaX",
  "version": "0.1.0",
  "description": "Desktop companion for NebulaX: ticket progress, PRs, update notifications and the NebulaX terminal.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac --dir",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.nebulax.desktop",
    "productName": "NebulaX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
